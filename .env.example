# PostGrab — Environment Variables

# Backend
PORT=8000
DEBUG=false
TEMP_DIR=./tmp
JOB_TTL_SECONDS=1800
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_DOWNLOAD_SIZE_MB=500
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://postgrab.onrender.com

# Frontend (Vite) — only needed for local dev when frontend runs separately
# VITE_API_URL=http://localhost:8000
